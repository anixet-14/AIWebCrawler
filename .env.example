UPC_USER_AGENT=UniversalProductCrawler/0.1 (+local, respectful crawler)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
UPC_TIMEOUT_SECONDS=15
# Never commit the real values. Cloudflare token must have Browser Run - Edit only.
CLOUDFLARE_ACCOUNT_ID=replace_with_your_account_id
CLOUDFLARE_API_TOKEN=replace_with_your_browser_run_token
UPC_REMOTE_DAILY_LIMIT=5
